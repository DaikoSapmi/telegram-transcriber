# .env.example - Ailo 2.0
# Kopier denne filen til .env og fyll inn dine verdier
# IKKE commit .env filen med ekte nøkler!

# ============================================
# PÅKREVDE INNSTILLINGER
# ============================================

# Telegram Bot Token (hent fra @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Bruker Autorisering (kommaseparert liste med Telegram user IDs)
# Finn din ID: https://t.me/userinfobot
# Eksempel: ALLOWED_USERS=123456789,987654321
# Tom = alle tillatt (IKKE anbefalt i produksjon)
ALLOWED_USERS=

# ============================================
# GEMINI - KORREKTUR (PÅKREVD)
# ============================================

# Google Gemini API for korrektur av transkripsjoner
# Hent API-nøkkel: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# ============================================
# VALGFRITT: LLM FOR MØTEREFERAT
# ============================================

# Velg provider: openai, anthropic, gemini, kimi, ollama
# Sett til "none" for å deaktivere møtereferat-funksjonen
LLM_PROVIDER=none

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Ollama (lokal LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ============================================
# SYSTEM INNSTILLINGER
# ============================================

# Temp og output mapper
TEMP_DIR=temp
OUTPUT_DIR=output

# Maks filstørrelse (MB)
MAX_FILE_SIZE_MB=500

# Slett temp filer etter prosessering
DELETE_TEMP_FILES=true

# ============================================
# MODELLER (ENDRES IKKE MED MINDRE DU VET HVA DU GJØR)
# ============================================

# Samisk ASR (Wav2Vec2 - 22.4k timer treningsdata)
SAMI_MODEL=GetmanY1/wav2vec2-large-sami-cont-pt-22k-finetuned

# Norsk ASR (Whisper - NbAiLab)
NORWEGIAN_MODEL=NbAiLab/nb-whisper-large

# Enhet: auto (velger beste), cpu, mps (Mac), cuda
ASR_DEVICE=auto
