# .env.example
# Kopier denne filen til .env og fyll inn dine verdier

# Telegram Bot Token (hent fra @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ASR (Automatic Speech Recognition) Innstillinger
ASR_MODEL=NbAiLab/nb-whisper-large
ASR_DEVICE=auto

# Standard språk (no = norsk, sme = nordsamisk)
DEFAULT_LANGUAGE=no

# Audio prosessering
SAMPLE_RATE=16000
CHUNK_DURATION=30

# Dokument generering
INCLUDE_TIMESTAMP=false
INCLUDE_SPEAKER_DETECTION=true
DOCUMENT_LANGUAGE=no

# Filhåndtering
MAX_FILE_SIZE_MB=500
DELETE_TEMP_FILES=true

# Bruker Autorisering (kommaseparert liste)
# Eksempler:
# ALLOWED_USERS=123456789,987654321,@brukernavn
# ALLOWED_USERS=@runefjellheim
# Tom = alle tillatt (IKKE anbefalt i produksjon)
ALLOWED_USERS=

# LLM for møtereferat (valgfritt, minst én må konfigureres)
# Velg provider: openai, anthropic, gemini, kimi, ollama, eller "auto" for første tilgjengelige
LLM_PROVIDER=auto

# OpenAI (GPT-4, GPT-4o, GPT-4o-mini)
# Hent API-nøkkel: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (claude-3-opus, claude-3-sonnet, claude-3-haiku)
# Hent API-nøkkel: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini (gemini-1.5-pro, gemini-1.5-flash)
# Hent API-nøkkel: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash

# Kimi (Moonshot AI - kimi-k2.5, kimi-k1.5, etc.)
# Hent API-nøkkel: https://platform.moonshot.cn/
KIMI_API_KEY=sk-...
KIMI_MODEL=kimi-k2.5

# Ollama (lokal LLM - krever at Ollama kjører)
# Installasjon: https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Mapper
TEMP_DIR=temp
OUTPUT_DIR=output
